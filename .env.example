# URL publik situs web KATARA (digunakan untuk canonical URL, sitemap, dan Open Graph)
NEXT_PUBLIC_SITE_URL=https://katara-web.vercel.app

#Repositori GitHub sumber rilis APK dan modul dialek
GITHUB_REPO_OWNER=rynnxz
GITHUB_REPO_NAME=KATARA

# Opsional: Token GitHub baca-publik sisi server untuk menaikkan batas rate limit API GitHub saat ISR.
# JANGAN gunakan awalan NEXT_PUBLIC_ pada variabel ini.
GITHUB_TOKEN=

# Opsional: Kode verifikasi Google Search Console & Bing Webmaster Tools
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
